# ---- Required ----
MONGODB_URI=mongodb://127.0.0.1:27017/musiglot
JWT_SECRET=change-me-to-a-long-random-string

# ---- Invite-only demo (optional) ----
# When set, signing up requires this code. Share it only with people you invite.
INVITE_CODE=

# ---- Server ----
PORT=4000
MEDIA_DIR=./media

# ---- LLM: Anthropic (recommended; optional) ----
# Used for: per-line translations/phonetics/glosses + grammar rating (pipeline),
# and feedback bullets (server). Without it the pipeline uses rule-based
# phonetics with no translations, and feedback bullets come from templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Azure Speech (optional; best pronunciation scoring) ----
# Used for: pronunciation assessment (es-MX / hi-IN) and optional cloud TTS.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_LOCALE_ES=es-MX
AZURE_LOCALE_HI=hi-IN

# ---- OpenAI Whisper API (optional) ----
# Used for: word-level alignment in the pipeline, and the pronunciation
# fallback when Azure is not configured.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# ---- Provider selection (all default to "auto") ----
# ALIGNER: auto | openai | local | heuristic
#   auto = openai if OPENAI_API_KEY, else local faster-whisper if installed, else heuristic
ALIGNER=auto
# Local faster-whisper model size (only for ALIGNER=local / PRONUNCIATION_PROVIDER=local)
WHISPER_LOCAL_MODEL=small
# PRONUNCIATION_PROVIDER: auto | azure | openai | local | estimate
#   auto = azure if key, else openai if key, else estimate (voicing only, not real pronunciation)
PRONUNCIATION_PROVIDER=auto
# Python used by the server for PRONUNCIATION_PROVIDER=local
PYTHON_BIN=python3

# ---- LRCLIB (no key) ----
LRCLIB_USER_AGENT=musiglot/0.1 (https://github.com/ishaanchip/musiglot)

# ---- Client (Vite) ----
# browser = speechSynthesis (default) | azure = server /api/tts (needs AZURE_SPEECH_KEY)
VITE_TTS_PROVIDER=browser
